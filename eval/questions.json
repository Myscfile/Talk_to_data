    {
      "id": "q04",
      "question": "What is the average review score?",
      "expect": [
        "ok"
      ],
      "ordered": false,
      "answers": [
        {
          "label": "per review",
          "sql": "SELECT AVG(review_score) FROM order_reviews",
          "rows": [
            [
              4.08642062404257
            ]
          ]
        },
        {
          "label": "per order",
          "sql": "SELECT AVG(s) FROM (SELECT AVG(review_score) AS s FROM order_reviews GROUP BY order_id)",
          "rows": [
            [
              4.0867934152875325
            ]
          ]
        }
      ]
    },
    {
      "id": "q05",
      "question": "How many orders were delivered late?",
      "expect": [
        "ok"
      ],
      "ordered": false,
      "answers": [
        {
          "label": "timestamp comparison",
          "sql": "SELECT COUNT(*) FROM orders WHERE order_delivered_customer_date IS NOT NULL AND order_delivered_customer_date > order_estimated_delivery_date",
          "rows": [
            [
              7827
            ]
          ]
        },
        {
          "label": "calendar-day comparison",
          "sql": "SELECT COUNT(*) FROM orders WHERE order_delivered_customer_date IS NOT NULL AND date(order_delivered_customer_date) > date(order_estimated_delivery_date)",
          "rows": [
            [
              6535
            ]
          ]
        }
      ]
    },
    {
      "id": "q06",
      "question": "What is the average delivery time in days?",
      "expect": [
        "ok"
      ],
      "ordered": false,
      "answers": [
        {
          "label": "reference",
          "sql": "SELECT AVG(julianday(order_delivered_customer_date) - julianday(order_purchase_timestamp)) FROM orders WHERE order_delivered_customer_date IS NOT NULL",
          "rows": [
            [
              12.558702304031995
            ]
          ]
        }
      ]
    },
    {
      "id": "q07",
      "question": "How many orders were placed in each year?",
      "expect": [
        "ok"
      ],
      "ordered": false,
      "answers": [
        {
          "label": "reference",
          "sql": "SELECT strftime('%Y', order_purchase_timestamp) AS year, COUNT(*) FROM orders GROUP BY year ORDER BY year",
          "rows": [
            [
              "2016",
              329
            ],
            [
              "2017",
              45101
            ],
            [
              "2018",
              54011
            ]
          ]
        }
      ]
    },
